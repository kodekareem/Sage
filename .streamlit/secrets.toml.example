# Copy this file to `.streamlit/secrets.toml` and fill in a key to enable one of
# the optional LLM engines. The app works fine WITHOUT any of these — it defaults
# to the free, no-key "rule" engine, which is what the deployed demo uses.
#
# NEVER commit the real `secrets.toml`; it is git-ignored for that reason.
#
# Groq — free tier, hosted open-weight models (easiest LLM option).
# Get a key at https://console.groq.com
# GROQ_API_KEY = "gsk_..."
#
# Anthropic — paid.
# ANTHROPIC_API_KEY = "sk-ant-..."
